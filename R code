colnames(plfs)


#Identify the correct state code for Uttar Pradesh 
unique_states <- unique(plfs$State_UT_Code)
print(unique_states)   # Look for 9, 33, or whatever code represents UP
up_code <- 9           # Change this to the correct code from the print output

# Define activity status codes
# Check the distribution of CWS_Status_Code to confirm the codes present
table(plfs$CWS_Status_Code)

# Based on typical PLFS coding:
employed_codes <- c(11, 12, 21, 31, 41)   # Employed
unemployed_codes <- c(51)                # Unemployed (only 51 in your data)
labour_force_codes <- c(employed_codes, unemployed_codes)  # All in labour force

#Filter and create indicators
plfs_up <- plfs %>%
  filter(State_UT_Code == up_code) %>%
  mutate(
    youth = ifelse(Age >= 15 & Age <= 29, 1, 0),
    is_labour_force = ifelse(CWS_Status_Code %in% labour_force_codes, 1, 0),
    is_unemployed    = ifelse(CWS_Status_Code %in% unemployed_codes, 1, 0)
  ) %>%
  filter(youth == 1)   # Keep only youth


#Check that we have data
if(nrow(plfs_up) == 0) stop("No youth data for UP. Check state code and youth definition.")
print(table(plfs_up$District_Code))  # Show distribution across districts

#Set survey design options to handle lonely PSUs
options(survey.lonely.psu = "adjust")

plfs_design <- svydesign(
  ids     = ~FSU,
  strata  = ~interaction(Stratum, Sub_Stratum),
  weights = ~Subsample_Multiplier,
  data    = plfs_up,
  nest    = TRUE
)

#Compute direct estimates and design variances per district
direct_estimates <- svyby(
  formula     = ~is_unemployed,
  by          = ~District_Code,
  design      = plfs_design,
  FUN         = svyratio,
  denominator = ~is_labour_force,
  keep.names  = FALSE,
  vartype     = c("se", "var")
)
head(direct_estimates)
# Transform to percentage
direct_pct <- direct_estimates %>%
  dplyr::mutate(
    # Multiply estimate by 100
    unemployment_pct =
      `is_unemployed/is_labour_force` * 100,
    
    # Multiply SE by 100
    se_pct =
      `se.is_unemployed/is_labour_force` * 100,
    
    # Multiply variance by 100^2 = 10000
    var_pct =
      `var.is_unemployed/is_labour_force` * 10000
  ) %>%
  dplyr::select(
    District_Code,
    unemployment_pct,
    se_pct,
    var_pct
  )
print(direct_pct)
