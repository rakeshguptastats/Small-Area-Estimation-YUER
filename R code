sample_index <- which(
  !is.na(final_data_df$Direct_UR)
)

# Check
length(D)
m
length(sample_index)
M

# Bootstrap settings

B <- 500

Theta_boot_matrix <- matrix(
  NA,
  nrow = M,
  ncol = B
)

FH_boot_matrix <- matrix(
  NA,
  nrow = M,
  ncol = B
)

set.seed(1234)

# Bootstrap loop

for (b in 1:B) {
  
  # Random area effects
  u_boot <- rnorm(
    M,
    mean = 0,
    sd = sqrt(sigma_u2)
  )
  
  # True area-level values
  theta_boot <- theta_hat + u_boot
  
  Theta_boot_matrix[, b] <-
    theta_boot
  
  # Sampling errors
  e_boot <- rnorm(
    m,
    mean = 0,
    sd = sqrt(D)
  )
  
  # Bootstrap direct estimates
  y_boot <-
    theta_boot[sample_index] +
    e_boot
  
  # Bootstrap dataset
  boot_data <- fh_data_df
  
  boot_data$Direct_UR <-
    y_boot
  
  boot_model <- sae::eblupFH(
    
    Direct_UR ~
      Mean_NTL +
      Urbanization_Rate +
      Total_Literacy +
      SC_Proportion +
      ST_Proportion +
      MGNREGA_Intensity +
      Active_Worker_Rate,
    
    vardir = Direct_Var,
    
    data = boot_data
  )
  
  # Bootstrap coefficients
  beta_boot <-
    boot_model$fit$estcoef$beta
  
  names(beta_boot) <-
    rownames(
      boot_model$fit$estcoef
    )
  
  # Synthetic prediction for all districts
  syn_boot <- as.vector(
    X_all %*% beta_boot
  )
  
  # Final FH prediction
  FH_boot <- syn_boot
  
  FH_boot[sample_index] <-
    as.vector(
      boot_model$eblup
    )
  
  FH_boot_matrix[, b] <-
    FH_boot
  
  if (b %% 50 == 0) {
    cat(
      "Bootstrap =",
      b,
      "\n"
    )
  }
}



Boot_Estimate <- rowMeans(
