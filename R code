)
theta_hat <- as.vector(
  
  X_all %*% beta_hat
  
)
sample_index <- !is.na(final_data_df$Direct_UR)
Theta_boot_matrix <- matrix(
  
  NA,
  
  nrow=M,
  
  ncol=B
  
)

SFH_boot_matrix <- matrix(
  
  NA,
  
  nrow=M,
  
  ncol=B
  
)
I_M <- diag(M)
set.seed(1234)

successful <- 0

for(b in 1:B){
  
  
  eps <- rnorm(
    
    M,
    
    0,
    
    sqrt(sigma_u2)
    
  )
  
  A <- I_M - rho_hat*W
  
  if(kappa(A) > 10000){
    
    next
    
  }
  
  u <- solve(A,eps)
  
  theta.star <- theta_hat + u
  
  Theta_boot_matrix[,b] <- theta.star
  
  e <- rnorm(
    
    m,
    
    0,
    
    sqrt(D)
    
  )
  

  y.star <- theta.star[sample_index] + e
  
  boot.data <- fh_data_df
  
  boot.data$Direct_UR <- y.star
  
  fit.star <- try(
    
    eblupSFH(
      
      Direct_UR~
        
        Mean_NTL+
        
        Urbanization_Rate+
        
        Total_Literacy+
        
        SC_Proportion+
        
        ST_Proportion+
        
        MGNREGA_Intensity+
        
        Active_Worker_Rate,
      
      vardir=Direct_Var,
      
      proxmat=W_sample,
      
      method="REML",
      
      data=boot.data
      
    ),
    
    silent=TRUE
    
  )
  
  if(inherits(fit.star,"try-error")){
    
    next
    
  }
  
  #Skip unstable rho
  
  rho.star <- fit.star$fit$spatialcorr
  
  if(abs(rho.star)>=0.99){
    
    next
    
  }
  
  beta.star <- fit.star$fit$estcoef$beta
  
  names(beta.star) <- rownames(
    
    fit.star$fit$estcoef
    
  )
  
  
  syn.star <- as.vector(
    
    X_all %*% beta.star
    
  )
  
  sfh.temp <- syn.star
  
  sfh.temp[sample_index] <-
    
    as.vector(fit.star$eblup)
  
  SFH_boot_matrix[,b] <- sfh.temp
  
  successful <- successful + 1
  
  if(successful%%25==0)
    
    cat("Successful bootstrap =",successful,"\n")
  
}

